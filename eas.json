{
    "cli": {
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            }
        },
        "production": {
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "ios": {
                "simulator": false
            }
        }
    }
}